# Copia este archivo a `.env` (`cp .env.example .env`).
# No subas `.env` a Git: está en .gitignore.
# Deja los valores vacíos si no los necesitas. No pegues claves ni contraseñas.

# Activa la ruta base de GitHub Pages (/nisar-pulse/) al compilar.
# Vacío = desarrollo local, la app se sirve en /.
# El workflow .github/workflows/deploy.yml lo pone en "true" al publicar.
# vite.config.js lee process.env.GITHUB_PAGES desde el entorno del sistema,
# no desde este archivo. Para probar el build de Pages en tu máquina:
#   GITHUB_PAGES=true npm run build
GITHUB_PAGES=

# Nota: src/App.jsx usa import.meta.env.BASE_URL.
# Esa variable la calcula Vite a partir de la opción `base` de vite.config.js.
# No se define aquí y no es una clave secreta.

# Token de Cesium ion para el relieve "Cesium World Terrain".
# Se crea en https://cesium.com/ion/tokens
# No lo pegues en el código ni en este archivo si vas a subirlo.
# Si lo dejas vacío, el globo intenta un modelo de elevación abierto
# (sin clave). Si ese modelo tampoco responde, el relieve dice
# "dato no disponible" y el globo queda en el elipsoide.
# En GitHub Actions el valor va como secreto VITE_CESIUM_ION_TOKEN
# (ver README). Nunca lo escribas en el repositorio.
VITE_CESIUM_ION_TOKEN=
