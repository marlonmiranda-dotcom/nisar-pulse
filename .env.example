# Copia este archivo a .env y no subas .env al repositorio.
#
# Token de Cesium ion para el relieve "Cesium World Terrain".
# Se crea en https://cesium.com/ion/tokens
# Si lo dejas vacío, el globo sigue funcionando con imágenes base libres
# y muestra "dato no disponible" en el relieve (elipsoide, sin alturas inventadas).
VITE_CESIUM_ION_TOKEN=
